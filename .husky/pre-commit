#!/usr/bin/env sh
set -e

echo "========================================================"
echo "  NEROLAC PRE-COMMIT HOOK: RUNNING QUALITY & GUARDRAILS"
echo "========================================================"

# Add local node_modules binaries to PATH
export PATH="./node_modules/.bin:$PATH"

# Locate Python tools (virtualenv or PATH)
if [ -f ".venv/bin/ruff" ]; then
  RUFF=".venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
  RUFF="ruff"
else
  RUFF="python3 -m ruff"
fi

if [ -f ".venv/bin/mypy" ]; then
  MYPY=".venv/bin/mypy"
elif command -v mypy >/dev/null 2>&1; then
  MYPY="mypy"
else
  MYPY="python3 -m mypy"
fi

if [ -f ".venv/bin/pytest" ]; then
  PYTEST=".venv/bin/pytest"
elif command -v pytest >/dev/null 2>&1; then
  PYTEST="pytest"
else
  PYTEST="python3 -m pytest"
fi

# 1. Python Linting with Ruff
echo "--> [1/6] Running Ruff (Python linter)..."
$RUFF check .

# 2. Static Type Checking with mypy
echo "--> [2/6] Running mypy (Static type checking)..."
$MYPY src tests scripts/verify_agent_compliance.py

# 3. Unit and Security Test Suites with pytest
echo "--> [3/6] Running pytest test suites..."
$PYTEST tests/ -q

# 4. Frontend Linting with ESLint
echo "--> [4/6] Running ESLint..."
npx eslint .

# 5. Code Formatting with Prettier
echo "--> [5/6] Running Prettier..."
npx prettier --check .

# 6. Agent Compliance and AST Guardrails
echo "--> [6/6] Running Agent Compliance & AST Guardrails..."
python3 scripts/verify_agent_compliance.py

echo "========================================================"
echo "  ALL PRE-COMMIT GATES PASSED (CODE 0) ✨"
echo "========================================================"
