{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 4,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "API Gateway & HTTP Latency Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Latency (P95 & P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nerolac_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "P95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(nerolac_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "P99 {{endpoint}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "HTTP Throughput by Status Code",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nerolac_http_requests_total[1m])) by (status_code)",
          "legendFormat": "Status {{status_code}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Database Connection Pool Saturation (PostgreSQL 16)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "PostgreSQL Connection States (Active vs Idle)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nerolac_db_pool_connections{state=\"active\"}",
          "legendFormat": "{{pool_type}} Active"
        },
        {
          "expr": "nerolac_db_pool_connections{state=\"idle\"}",
          "legendFormat": "{{pool_type}} Idle"
        },
        {
          "expr": "nerolac_db_pool_connections{state=\"overflow\"}",
          "legendFormat": "{{pool_type}} Overflow"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.85 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "DB Connection Pool Utilization Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "nerolac_db_pool_utilization_ratio",
          "legendFormat": "{{pool_type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Redis Multi-Instance Caching & Celery Queue Observability",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.6 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "title": "Redis Cache Hit Ratio",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nerolac_redis_cache_hit_ratio",
          "legendFormat": "{{db_instance}} Hit Ratio"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "title": "Celery Asynchronous Queue Depth",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nerolac_celery_queue_depth",
          "legendFormat": "Queue {{queue_name}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "ML Model Performance & Forecasting Error Drift",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 15 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "title": "Ensemble Demand Forecast MAPE (% Error)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nerolac_ml_forecast_mape",
          "legendFormat": "{{depot_id}} - {{sku_id}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "masskg"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "title": "Demand Forecast RMSE (Metric Tons)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nerolac_ml_forecast_rmse",
          "legendFormat": "{{depot_id}} - {{sku_id}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "light",
  "tags": ["nerolac", "operations", "production", "fastapi", "postgresql", "redis", "celery", "ml"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Nerolac Operations Dashboard - Production Observability",
  "uid": "nerolac-ops-observability",
  "version": 1
}
